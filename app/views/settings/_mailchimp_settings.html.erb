<% lookup = RedmineMailchimp::SettingsLookup.new(settings) %>
<% lists = lookup.api_key? ? lookup.lists : [] %>
<% tags = lookup.merge_field_tags %>
<% user_fields = [''] + lookup.user_field_names %>
<% merge_tags = [''] + tags %>

<% if lookup.error %>
  <div class="flash error"><%= lookup.error %></div>
<% end %>

<p>
  <label for="settings_api_key">Mailchimp API Key</label>
  <%= text_field_tag 'settings[api_key]', settings['api_key'], size: 50, autocomplete: 'off' %>
</p>

<% if lookup.api_key? && lists.any? %>
  <p>
    <label for="settings_list_id">Mailchimp List</label>
    <%= select_tag 'settings[list_id]', options_for_select([['', '']] + lists, settings['list_id']) %>
  </p>
<% end %>

<p>
  <label for="settings_double_optin">Double Opt-in</label>
  <%= check_box_tag 'settings[double_optin]', true, settings['double_optin'].present? %>
</p>
<p>
  <label for="settings_update_existing">Update Existing</label>
  <%= check_box_tag 'settings[update_existing]', true, settings['update_existing'].present? %>
</p>

<% if tags.any? %>
  <h3>Merge fields</h3>
  <% tags.each_index do |i| %>
    <p>
      <label for="settings_merge_field_<%= i %>">Mailchimp merge field</label>
      <%= select_tag "settings[merge_field_#{i}]", options_for_select(merge_tags, settings["merge_field_#{i}"]) %>
      <%= select_tag "settings[user_field_#{i}]", options_for_select(user_fields, settings["user_field_#{i}"]) %>
    </p>
  <% end %>
<% end %>
